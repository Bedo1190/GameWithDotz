<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cstm"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#61BF9D">

    <!-- Title always pinned at the top -->
    <TextView
        android:id="@+id/Customize"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/leaguespartan"
        android:text="Customize"
        android:textColor="#FFFFFF"
        android:textSize="60sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Scroll container with 4 grids and labels -->
    <ScrollView
        android:id="@+id/scrollContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/Customize"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- First Grid -->
            <GridLayout
                android:id="@+id/customGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal"
                android:padding="8dp">

                <!-- Example cell -->
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
            </GridLayout>

            <!-- Label: GreenDotz -->
            <TextView
                android:id="@+id/greenDotzLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/leaguespartan"
                android:text="GreenDotz"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Second Grid -->
            <GridLayout
                android:id="@+id/greenGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/specialdot_green"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />

            </GridLayout>

            <!-- Label: RedDotz -->
            <TextView
                android:id="@+id/redDotzLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/leaguespartan"
                android:text="RedDotz"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Third Grid -->
            <GridLayout
                android:id="@+id/redGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/specialdot_red"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />

            </GridLayout>

            <!-- Label: BlueDotz -->
            <TextView
                android:id="@+id/blueDotzLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/leaguespartan"
                android:text="BlueDotz"
                android:textColor="#FFFFFF"
                android:textSize="40sp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp" />

            <!-- Fourth Grid -->
            <GridLayout
                android:id="@+id/blueGrid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="3"
                android:orientation="horizontal"
                android:padding="8dp">
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/specialdot_blue"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />
                <ImageButton
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_rowWeight="1"
                    android:background="@drawable/custom_button"
                    android:src="@drawable/dot"
                    android:layout_margin="4dp" />

            </GridLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Your original buttonRow (unchanged) -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="8dp"
        android:translationY="300dp"
        android:translationZ="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/Customize"
        app:layout_constraintVertical_bias="0.49">

        <Button
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="goBack"
            android:text="Back" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
