<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>

            <!-- faint outer ring to separate from backgrounds -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#00000000"/>
                    <stroke android:width="2dp" android:color="#FFEEEEEE"/>
                    <size android:width="56dp" android:height="56dp"/>
                </shape>
            </item>

            <!-- glossy gradient white center -->
            <item android:top="4dp" android:left="4dp" android:right="4dp" android:bottom="4dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#FFFFFFFF"
                        android:centerColor="#FFF9F9F9"
                        android:endColor="#FFF1F1F1"
                        android:type="linear"/>
                    <size android:width="52dp" android:height="52dp"/>
                </shape>
            </item>

        </layer-list>
    </item>
</selector>
