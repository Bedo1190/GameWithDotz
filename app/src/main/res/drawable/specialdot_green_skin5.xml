<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>

            <!-- soft halo -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#331D8465"/> <!-- translucent teal halo -->
                    <size android:width="72dp" android:height="72dp"/>
                </shape>
            </item>

            <!-- outer ring -->
            <item android:top="6dp" android:left="6dp" android:right="6dp" android:bottom="6dp">
                <shape android:shape="oval">
                    <solid android:color="#00000000"/>
                    <stroke android:width="4dp" android:color="#0F4C3B"/>
                    <size android:width="60dp" android:height="60dp"/>
                </shape>
            </item>

            <!-- glossy center -->
            <item android:top="10dp" android:left="10dp" android:right="10dp" android:bottom="10dp">
                <shape android:shape="oval">
                    <gradient
                        android:angle="270"
                        android:startColor="#F0FBF8"
                        android:centerColor="#1D8465"
                        android:endColor="#165E50"
                        android:type="linear" />
                    <size android:width="48dp" android:height="48dp"/>
                </shape>
            </item>

            <!-- highlight -->
            <item android:top="12dp" android:left="18dp" android:right="18dp" android:bottom="28dp">
                <shape android:shape="oval">
                    <solid android:color="#66FFFFFF"/>
                    <size android:width="18dp" android:height="10dp"/>
                </shape>
            </item>

        </layer-list>
    </item>
</selector>
