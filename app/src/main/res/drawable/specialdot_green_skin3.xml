<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <layer-list>
            <!-- soft translucent halo -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="#331D8465"/> <!-- translucent teal glow -->
                    <size android:width="72dp" android:height="72dp"/>
                </shape>
            </item>

            <!-- mid ring for depth -->
            <item android:top="8dp" android:left="8dp" android:right="8dp" android:bottom="8dp">
                <shape android:shape="oval">
                    <solid android:color="#FBFFFE"/>
                    <stroke android:width="2dp" android:color="#1D8465"/>
                    <size android:width="56dp" android:height="56dp"/>
                </shape>
            </item>

            <!-- solid deep teal center -->
            <item android:top="14dp" android:left="14dp" android:right="14dp" android:bottom="14dp">
                <shape android:shape="oval">
                    <solid android:color="#165E50"/>
                    <size android:width="44dp" android:height="44dp"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
